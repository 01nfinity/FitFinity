generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String
  isAdmin      Boolean    @default(false)
  templates    Template[]
  exercises    Exercise[]
  logs         Log[]
}

model Template {
  id          Int                @id @default(autoincrement())
  userId      Int?               // Nullable for global templates
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isGlobal    Boolean            @default(false)
  exercises   TemplateExercise[]
}

model TemplateExercise {
  id            Int      @id @default(autoincrement())
  templateId    Int
  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseName  String
  targetSets    Int      @default(1)
  targetReps    String   @default("1")
  targetWeight  Float    @default(0)
}

model Exercise {
  id          Int      @id @default(autoincrement())
  userId      Int?     // Nullable if global
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  categories  String[] @default([])
  imageUrl    String?
  description String?
  isGlobal    Boolean  @default(false)
}

model Log {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String
  templateName String?
  sentiment    String?
  sets         LogSet[]
}

model LogSet {
  id           Int     @id @default(autoincrement())
  logId        Int
  log          Log     @relation(fields: [logId], references: [id], onDelete: Cascade)
  exerciseName String
  weight       Float?
  reps         Int?
  completed    Boolean @default(false)
}
